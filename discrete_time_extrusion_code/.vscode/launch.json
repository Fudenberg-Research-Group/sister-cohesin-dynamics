{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File (discrete-extrusion)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "interpreterPath": "/Users/xcyan/opt/anaconda3/envs/discrete-extrusion/bin/python",
            "justMyCode": false,
            "python": "/Users/xcyan/opt/anaconda3/envs/discrete-extrusion/bin/python"
        },
        {
            "name": "Python: Attach to discrete-extrusion (debugpy)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${workspaceFolder}"
                }
            ]
        },
        {
            "name": "Python: discrete-extrusion (args=1)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "interpreterPath": "/Users/xcyan/opt/anaconda3/envs/discrete-extrusion/bin/python",
            "justMyCode": false,
            "args": [
                "1"
            ],
            "env": {
                "PATH": "/Users/xcyan/opt/anaconda3/envs/discrete-extrusion/bin:/Users/xcyan/opt/anaconda3/bin:${env:PATH}"
            },
            "python": "/Users/xcyan/opt/anaconda3/envs/discrete-extrusion/bin/python"
        }
    ]
}
