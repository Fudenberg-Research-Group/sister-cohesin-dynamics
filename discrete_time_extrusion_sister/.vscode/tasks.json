{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "activate-discrete-extrusion",
            "type": "shell",
            "command": "conda activate discrete-extrusion && python",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^.*$"
                }
            }
        }
    ]
}
